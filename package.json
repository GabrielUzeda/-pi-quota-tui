{
  "name": "notutil-pi",
  "version": "0.2.0",
  "description": "Quotas de IA e pets pixel-art no painel lateral do pi",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "quota",
    "pixel-art"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "test": "node --test \"tests/*.test.ts\" && node tests/extension.smoke.mjs",
    "typecheck": "tsc --noEmit",
    "export-pets": "python3 scripts/export_pets_data.py"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-tui": "1.4.0",
    "@types/node": "^24.0.0",
    "jiti": "^2.7.0",
    "typebox": "1.3.27",
    "typescript": "^5.9.0"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "author": "gsuzeda",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gsuzeda/notutil.git"
  },
  "homepage": "https://github.com/gsuzeda/notutil#readme",
  "bugs": {
    "url": "https://github.com/gsuzeda/notutil/issues"
  }
}
